# ==============================================================================
# WakilAI Legal RAG & Universal AI Gateway - Environment Configuration
# Copy this file to `.env` inside `backend/` and fill in the keys you need.
# Never commit `.env`.
# ==============================================================================

# --- AI Model Providers (configure any one or multiple) ---
# KiloAI Gateway (supports free models such as kilo-auto/free)
KILOCODE_API_KEY=
KILO_BASE_URL=https://api.kilo.ai/api/gateway
DEFAULT_KILO_MODEL=kilo-auto/free

# Google Gemini (current google-genai SDK)
GEMINI_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# Generic OpenAI-Compatible Gateway (OpenAI, OpenRouter, Ollama, LM Studio, vLLM, Groq, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEFAULT_OPENAI_MODEL=gpt-4o-mini

# Provider selection: auto | kilo | gemini | openai_compatible
DEFAULT_LLM_PROVIDER=auto
DEFAULT_TEMPERATURE=0.2
DEFAULT_MAX_TOKENS=2048

# --- Live Web Search ---
# Tavily primary search (falls back automatically to DuckDuckGo `ddgs` if unset)
TAVILY_API_KEY=

# --- Embeddings & Hybrid Vector Store ---
# Embedding provider: auto | fastembed | gemini | openai | hashed_tfidf
# `auto` prefers local multilingual fastembed (Devanagari + English, 384d, zero rate limits),
# falling back to Gemini, OpenAI-compatible embeddings, or deterministic hashed_tfidf.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Leave QDRANT_URL empty to use zero-config embedded persistent disk storage at QDRANT_PATH.
# Set QDRANT_URL=http://localhost:6333 (or http://qdrant:6333 in Docker) for remote Qdrant.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=wakil_nepal_laws

# Paths resolve relative to `backend/` when not absolute
QDRANT_PATH=./data/qdrant
BM25_PATH=./data/bm25_index.json
MANIFEST_PATH=./data/corpus_manifest.json
RAW_DATA_DIR=./data/raw

# --- Optional Firebase Auth Verification (RAG & AI routing work standalone by default) ---
FIREBASE_PROJECT_ID=wakil-3a91d
FIREBASE_AUTH_REQUIRED=false

# --- FastAPI Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=["*"]
